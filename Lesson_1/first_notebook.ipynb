   ],
   "source": [
    "# Список цін товарів у кошику\n",
    "prices = [250, 480, 400]\n",
    "total = 0\n",
    "\n",
    "for price in prices:\n",
    "    total = total + price\n",
    "\n",
    "if total >= 1000:\n",
    "    print(\"Безкоштовна доставка\")\n",
    "else:\n",
    "    print(\"Не вистачає до 1000:\", 1000 - total)"
   ]
  }
 ],
